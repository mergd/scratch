{
  "name": "@fldr/scratch",
  "version": "0.1.0",
  "description": "User feedback toolbar for apps — mark what's confusing, unlock with three circles or Cmd/Ctrl+Shift+U",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mergd/scratch.git"
  },
  "homepage": "https://github.com/mergd/scratch#readme",
  "bugs": {
    "url": "https://github.com/mergd/scratch/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE",
    "UPSTREAM_LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "demo": "vite --config demo/vite.config.ts",
    "prepack": "bun run build",
    "test": "vitest run --passWithNoTests"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@types/node": "^22.15.30",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.8",
    "postcss": "^8.5.6",
    "postcss-modules": "^6.0.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sass": "^1.89.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10"
  }
}
